<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Boda Hermes & Sofía - Save Our Date</title>
    <!-- Fuentes Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cinzel:wght@400;600;700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <!-- FontAwesome para Íconos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- SweetAlert2 para Alertas Interactivas -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        :root {
            --bg-body: #FAF5F6;
            --rosa-palo: #FDF0F4;
            --rosa-rubor: #F4C2C2;
            --rosa-acento: #E892A0;
            --blanco: #FFFFFF;
            --negro-azabache: #1A1A1A;
            --negro-suave: #222222;
            --gris-texto: #555555;
            --sombra-suave: 0 10px 30px rgba(232, 146, 160, 0.15);
            --sombra-card: 0 4px 20px rgba(0, 0, 0, 0.05);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--bg-body);
            color: var(--negro-azabache);
            line-height: 1.6;
            overflow-x: hidden;
        }

        /* Tipografías especiales */
        .font-script {
            font-family: 'Alex Brush', cursive;
        }
        .font-serif {
            font-family: 'Cinzel', serif;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
        }

        /* --- PORTADA / HERO --- */
        .hero {
            text-align: center;
            padding: 40px 20px 20px;
        }

        .image-frame {
            position: relative;
            display: inline-block;
            margin-bottom: 25px;
            border-radius: 16px;
            padding: 12px;
            background: var(--blanco);
            box-shadow: var(--sombra-suave);
            border: 1px solid var(--rosa-rubor);
        }

        .hero-img {
            max-width: 100%;
            width: 380px;
            height: auto;
            border-radius: 12px;
            display: block;
        }

        .hero-title {
            font-size: 2.8rem;
            letter-spacing: 4px;
            color: var(--negro-azabache);
            margin-bottom: 5px;
            font-weight: 600;
        }

        .hero-subtitle {
            font-size: 2.5rem;
            color: var(--negro-suave);
            margin-bottom: 15px;
        }

        /* --- CUENTA ATRÁS --- */
        .countdown-container {
            background: var(--blanco);
            border-radius: 16px;
            padding: 25px 15px;
            margin: 30px 0;
            box-shadow: var(--sombra-suave);
            border: 1px solid var(--rosa-palo);
            text-align: center;
        }

        .countdown-title {
            font-size: 1.1rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--gris-texto);
            margin-bottom: 15px;
        }

        .countdown-timer {
            display: flex;
            justify-content: center;
            gap: 15px;
            flex-wrap: wrap;
        }

        .time-box {
            background: var(--rosa-palo);
            border-radius: 12px;
            padding: 12px 18px;
            min-width: 75px;
            border: 1px solid var(--rosa-rubor);
        }

        .time-number {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--negro-azabache);
            display: block;
        }

        .time-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--gris-texto);
        }

        /* --- DETALLES DEL EVENTO (FECHA, LUGAR, HORA) --- */
        .details-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin: 30px 0;
        }

        .detail-card {
            background: var(--blanco);
            padding: 30px 20px;
            border-radius: 16px;
            text-align: center;
            box-shadow: var(--sombra-card);
            border: 1px solid var(--rosa-palo);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .detail-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--sombra-suave);
        }

        .detail-icon {
            width: 60px;
            height: 60px;
            background: var(--rosa-palo);
            color: var(--negro-azabache);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px;
            font-size: 1.5rem;
            border: 1px solid var(--rosa-rubor);
        }

        .detail-title {
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--gris-texto);
            margin-bottom: 8px;
        }

        .detail-text {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--negro-azabache);
        }

        .btn-maps {
            display: inline-block;
            margin-top: 12px;
            padding: 8px 16px;
            background: transparent;
            color: var(--negro-azabache);
            border: 1px solid var(--negro-azabache);
            border-radius: 20px;
            font-size: 0.8rem;
            text-decoration: none;
            transition: all 0.3s ease;
            font-weight: 600;
        }

        .btn-maps:hover {
            background: var(--negro-azabache);
            color: var(--blanco);
        }

        /* --- FORMULARIO RSVP --- */
        .rsvp-section {
            background: var(--blanco);
            border-radius: 20px;
            padding: 35px 25px;
            margin: 40px 0;
            box-shadow: var(--sombra-suave);
            border: 1px solid var(--rosa-rubor);
        }

        .rsvp-header {
            text-align: center;
            margin-bottom: 25px;
        }

        .rsvp-title {
            font-size: 2rem;
            color: var(--negro-azabache);
            margin-bottom: 5px;
        }

        .rsvp-subtitle {
            font-size: 0.95rem;
            color: var(--gris-texto);
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            display: block;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 600;
            margin-bottom: 8px;
            color: var(--negro-azabache);
        }

        .form-input, .form-select {
            width: 100%;
            padding: 12px 15px;
            border: 1px solid var(--rosa-rubor);
            border-radius: 10px;
            background-color: var(--rosa-palo);
            font-family: inherit;
            font-size: 1rem;
            color: var(--negro-azabache);
            outline: none;
            transition: border-color 0.3s ease;
        }

        .form-input:focus, .form-select:focus {
            border-color: var(--rosa-acento);
            background-color: var(--blanco);
        }

        /* Radio Buttons Asistencia */
        .radio-group {
            display: flex;
            gap: 15px;
            flex-direction: column;
        }

        .radio-option {
            display: flex;
            align-items: center;
            background: var(--rosa-palo);
            padding: 12px 15px;
            border-radius: 10px;
            border: 1px solid var(--rosa-rubor);
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .radio-option:hover {
            border-color: var(--rosa-acento);
        }

        .radio-option input[type="radio"] {
            margin-right: 12px;
            accent-color: var(--negro-azabache);
            width: 18px;
            height: 18px;
        }

        .radio-label {
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--negro-azabache);
            cursor: pointer;
        }

        /* Botón Enviar */
        .btn-submit {
            width: 100%;
            padding: 15px;
            background: var(--rosa-acento);
            color: var(--blanco);
            border: none;
            border-radius: 30px;
            font-size: 1rem;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(232, 146, 160, 0.4);
            margin-top: 10px;
        }

        .btn-submit:hover {
            background: var(--negro-azabache);
            color: var(--blanco);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
        }

        footer {
            text-align: center;
            padding: 30px 0;
            font-size: 0.85rem;
            color: var(--gris-texto);
        }

        /* Responsivo */
        @media (max-width: 600px) {
            .hero-title { font-size: 2.2rem; }
            .hero-subtitle { font-size: 2rem; }
            .time-box { min-width: 65px; padding: 8px 12px; }
            .time-number { font-size: 1.4rem; }
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- 1. PORTADA / HERO -->
        <header class="hero">
            <div class="image-frame">
                <!-- Asegúrate de incluir la imagen boda.jpg en la misma carpeta -->
                <img src="boda.jpg" alt="Hermes & Sofía" class="hero-img" onerror="this.src='https://via.placeholder.com/380x500/FDF0F4/1A1A1A?text=Hermes+%26+Sof%C3%ADa'">
            </div>
            <p class="hero-subtitle font-script">Save Our Date</p>
            <h1 class="hero-title font-serif">HERMES & SOFÍA</h1>
        </header>

        <!-- 2. CUENTA ATRÁS -->
        <section class="countdown-container">
            <h2 class="countdown-title font-serif">Tiempo restante para el gran día</h2>
            <div class="countdown-timer">
                <div class="time-box">
                    <span class="time-number" id="days">00</span>
                    <span class="time-label">Días</span>
                </div>
                <div class="time-box">
                    <span class="time-number" id="hours">00</span>
                    <span class="time-label">Horas</span>
                </div>
                <div class="time-box">
                    <span class="time-number" id="minutes">00</span>
                    <span class="time-label">Min</span>
                </div>
                <div class="time-box">
                    <span class="time-number" id="seconds">00</span>
                    <span class="time-label">Seg</span>
                </div>
            </div>
        </section>

        <!-- 3, 4 y 5. DETALLES DEL EVENTO (FECHA, LUGAR, HORA) -->
        <section class="details-grid">
            <!-- REQUERIMIENTO 3: FECHA -->
            <div class="detail-card">
                <div class="detail-icon">
                    <i class="fa-regular fa-calendar-days"></i>
                </div>
                <div class="detail-title font-serif">Fecha</div>
                <div class="detail-text">Sábado 03 de Octubre 2026</div>
            </div>

            <!-- REQUERIMIENTO 4: LUGAR -->
            <div class="detail-card">
                <div class="detail-icon">
                    <i class="fa-solid fa-church"></i>
                </div>
                <div class="detail-title font-serif">Lugar</div>
                <div class="detail-text">Iglesia Frater</div>
                <a href="https://maps.google.com/?q=Iglesia+Frater" target="_blank" class="btn-maps">
                    <i class="fa-solid fa-location-dot"></i> Ver en Google Maps
                </a>
            </div>

            <!-- REQUERIMIENTO 5: HORA -->
            <div class="detail-card">
                <div class="detail-icon">
                    <i class="fa-regular fa-clock"></i>
                </div>
                <div class="detail-title font-serif">Hora</div>
                <div class="detail-text">Hora: 3:00 PM</div>
            </div>
        </section>

        <!-- 6. MINI FORMULARIO RSVP -->
        <section class="rsvp-section">
            <div class="rsvp-header">
                <h2 class="rsvp-title font-serif">Confirmación de Asistencia</h2>
                <p class="rsvp-subtitle">Por favor confirma tu presencia antes del evento</p>
            </div>

            <!-- Reemplaza TU_FORM_ID con tu id de Formspree -->
            <form id="rsvpForm" action="https://formspree.io/f/TU_FORM_ID" method="POST">
                <div class="form-group">
                    <label class="form-label" for="nombre">Nombre y Apellido</label>
                    <input type="text" id="nombre" name="nombre_completo" class="form-input" placeholder="Ej. Juan Pérez" required>
                </div>

                <div class="form-group">
                    <label class="form-label" for="personas">Número de personas</label>
                    <select id="personas" name="numero_personas" class="form-select" required>
                        <option value="1">1 Persona</option>
                        <option value="2">2 Personas</option>
                        <option value="3">3 Personas</option>
                        <option value="4">4 Personas</option>
                        <option value="5">5 Personas</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">¿Nos acompañarás?</label>
                    <div class="radio-group">
                        <label class="radio-option">
                            <input type="radio" name="asistencia" value="Acepto invitación / ¡Ahí estaré!" required>
                            <span class="radio-label">Acepto invitación / ¡Ahí estaré!</span>
                        </label>
                        <label class="radio-option">
                            <input type="radio" name="asistencia" value="No podré asistir">
                            <span class="radio-label">No podré asistir</span>
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn-submit font-serif">Enviar Confirmación</button>
            </form>
        </section>

        <footer>
            <p class="font-serif">Hermes & Sofía — 03.10.2026</p>
        </footer>
    </div>

    <!-- LOGICA EN JAVASCRIPT -->
    <script>
        // LÓGICA DE LA CUENTA ATRÁS (03 de Octubre de 2026, 15:00:00)
        const targetDate = new Date('October 3, 2026 15:00:00').getTime();

        function updateCountdown() {
            const now = new Date().getTime();
            const difference = targetDate - now;

            if (difference > 0) {
                const days = Math.floor(difference / (1000 * 60 * 60 * 24));
                const hours = Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((difference % (1000 * 60)) / 1000);

                document.getElementById('days').innerText = days < 10 ? '0' + days : days;
                document.getElementById('hours').innerText = hours < 10 ? '0' + hours : hours;
                document.getElementById('minutes').innerText = minutes < 10 ? '0' + minutes : minutes;
                document.getElementById('seconds').innerText = seconds < 10 ? '0' + seconds : seconds;
            } else {
                document.querySelector('.countdown-container').innerHTML = '<h2 class="countdown-title font-serif">¡Hoy es el gran día!</h2>';
            }
        }

        setInterval(updateCountdown, 1000);
        updateCountdown();

        // MANEJO DEL FORMULARIO CON SWEETALERT2
        const form = document.getElementById('rsvpForm');

        form.addEventListener('submit', function(e) {
            e.preventDefault();
            const formData = new FormData(form);

            fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: {
                    'Accept': 'application/json'
                }
            }).then(response => {
                Swal.fire({
                    title: '¡Muchas Gracias!',
                    text: 'Tu respuesta ha sido enviada con éxito.',
                    icon: 'success',
                    confirmButtonColor: '#1A1A1A',
                    confirmButtonText: 'Cerrar',
                    background: '#FFFFFF',
                    color: '#1A1A1A'
                });
                form.reset();
            }).catch(error => {
                Swal.fire({
                    title: '¡Gracias por responder!',
                    text: 'Se ha registrado tu respuesta correctamente.',
                    icon: 'success',
                    confirmButtonColor: '#1A1A1A',
                    confirmButtonText: 'Cerrar'    
                });
                form.reset();
            });
        });
    </script>
</body>
</html>
